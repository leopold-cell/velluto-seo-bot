.env
token_usage.json
topics_used.json
cron.log
__pycache__/
*.pyc
venv/
.venv/

# Phase 1+ research artifacts — large, ephemeral, not source-of-truth.
data/raw/
data/snapshots/
data/processed/*
!data/raw/.gitkeep
!data/snapshots/.gitkeep
!data/processed/.gitkeep

# Phase 3+ daily output — regenerated every cron run on the VPS.
output/*
!output/.gitkeep
!output/localization_briefs/
# 28-day blog review reports are an audit trail — keep them versioned.
!output/blog_review/
!output/blog_review/**
# Two logs that are the ONLY record of decisions made on the VPS: the monthly
# SEO-sales / blog-conversion trend, and WHY the quality gate blocked a publish.
# Kept out of the repo, they existed only in the daily email — a conversion
# number nobody could act on and a nine-day publish stall nobody could diagnose.
# Neither holds secrets; run.sh's secret scanner still guards every push.
!output/seo_sales_history.json
!output/quality_gate_failures.json

# Local-only logs
manual_test.log

# Secrets & editor backups (never commit — see .env.save leak 2026-06-30)
.env
.env.*
*.save
*.bak
*~
# Google service-account key for Drive uploads (drive_upload.py) — secret, never commit.
gdrive_sa.json
*service_account*.json
credentials*.json
# Local reel renders
output/reels/
# Resource-monitor throttle state
resource_monitor_state.json
